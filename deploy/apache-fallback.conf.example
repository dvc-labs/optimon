# Replace BOTH certificate paths before enabling this site.
# The certificate must cover dashboard-fallback.davevancauwenberghe.be.
# Keep Cloudflare Full (strict); private keys remain on the Apache host.
<VirtualHost *:80>
    ServerName dashboard-fallback.davevancauwenberghe.be
    Redirect permanent / https://dashboard-fallback.davevancauwenberghe.be/
</VirtualHost>

<VirtualHost *:443>
    ServerName dashboard-fallback.davevancauwenberghe.be

    SSLEngine on
    SSLCertificateFile /REPLACE/WITH/CERTIFICATE-FULLCHAIN.pem
    SSLCertificateKeyFile /REPLACE/WITH/PRIVATE-KEY.pem

    ProxyRequests Off
    ProxyPreserveHost On
    # Preserve the app's deliberate 503 JSON and origin headers.
    ProxyErrorOverride Off
    ProxyPass / http://127.0.0.1:18080/ connectiontimeout=3 timeout=10
    ProxyPassReverse / http://127.0.0.1:18080/
</VirtualHost>
