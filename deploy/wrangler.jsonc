{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "optimon-dashboard-failover",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "dashboard.davevancauwenberghe.be/*",
      "zone_name": "davevancauwenberghe.be",
    },
  ],
  "vars": {
    "DASHBOARD_PUBLIC_URL": "https://dashboard.davevancauwenberghe.be",
    "FALLBACK_ORIGIN": "https://dashboard-fallback.davevancauwenberghe.be",
    "ORIGIN_TIMEOUT_MS": "2500",
  },
  "observability": { "enabled": false },
}
