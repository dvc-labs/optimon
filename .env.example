# Runtime secrets: set these in Coolify. Never commit a real .env file.
DISCORD_TOKEN=

# Public Discord IDs; keep these as strings, never JavaScript numbers.
APPLICATION_ID=1562643787510063217
GUILD_ID=1562082957022204006
CHANNEL_ID=1562960345860153444
# Optional owner Discord user ID. Blank disables all owner controls.
ADMIN_ID=

HOST_NAME=optiplex
STATS_INTERVAL_MINUTES=15
THERMAL_ALERTS_ENABLED=true
# Optional absolute path for local development; defaults to ./data/history.json.
# Compose fixes this to /app/data/history.json on the persistent volume.
HISTORY_FILE=
# CLIENT_ID is an optional alias for APPLICATION_ID; do not set conflicting values.
