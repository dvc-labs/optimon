# Runtime secrets: set these in Coolify. Never commit a real .env file.
DISCORD_TOKEN=

# Public Discord IDs; keep these as strings, never JavaScript numbers.
APPLICATION_ID=
GUILD_ID=
CHANNEL_ID=
# Optional owner Discord user ID. Blank disables all owner controls.
ADMIN_ID=
# Live command records expire after 90 days. 0 keeps them indefinitely.
AUDIT_RETENTION_DAYS=90

HOST_NAME=optiplex
STATS_INTERVAL_MINUTES=30
THERMAL_ALERTS_ENABLED=true
# Optional disk variant: see README. Prepare an empty directory on the host root filesystem first.
DISK_HOST_PATH=/var/lib/optimon-disk
DISK_ALERTS_ENABLED=true
# Local development only; the optional disk Compose variant fixes this container path.
HOST_DISK_PATH=
# Optional absolute path for local development; defaults to ./data/history.json.
# Legacy migration source. Compose fixes this to /app/data/history.json.
HISTORY_FILE=
# Local development only; defaults to ./data/optiplex.sqlite.
# Compose fixes this on the existing local Docker volume, never NFS/SMB.
DATABASE_FILE=
# Optional secret HTTPS ping URL from Healthchecks.io or an Uptime Kuma push monitor.
HEARTBEAT_URL=
# Required when deploying the dashboard with compose.yaml.
DASHBOARD_PUBLIC_URL=https://dashboard.davevancauwenberghe.be
# Host certificate directory; private key must never be placed in the repo.
DASHBOARD_TLS_HOST_PATH=/etc/optiplex-dashboard/tls
# Optional deployment-only value for the fallback DNS A record; enter privately in .env.
# Not used by either container or the Worker. See FALLBACK.md.
VPS_PUBLIC_IP=
# Local development only. Compose fixes this to a separate metrics-only volume.
PUBLIC_DATA_PATH=
# CLIENT_ID is an optional alias for APPLICATION_ID; do not set conflicting values.
