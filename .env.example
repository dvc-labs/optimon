# Runtime secrets: set these in Coolify. Never commit a real .env file.
DISCORD_TOKEN=

# Public Discord IDs; keep these as strings, never JavaScript numbers.
APPLICATION_ID=
GUILD_ID=
CHANNEL_ID=
# Optional owner Discord user ID. Blank disables all owner controls.
ADMIN_ID=
# Live command records expire after 90 days. 0 keeps them indefinitely.
AUDIT_RETENTION_DAYS=90

HOST_NAME=optiplex
STATS_INTERVAL_MINUTES=30
THERMAL_ALERTS_ENABLED=true
# Optional absolute path for local development; defaults to ./data/history.json.
# Legacy migration source. Compose fixes this to /app/data/history.json.
HISTORY_FILE=
# Local development only; defaults to ./data/optiplex.sqlite.
# Compose fixes this on the existing local Docker volume, never NFS/SMB.
DATABASE_FILE=
# Optional secret HTTPS ping URL from Healthchecks.io or an Uptime Kuma push monitor.
HEARTBEAT_URL=
# CLIENT_ID is an optional alias for APPLICATION_ID; do not set conflicting values.
